# ---------------------------------------------------------------------------
# RAG Quality Monitor — example configuration.
# Copy to `.env` and adjust. NEVER commit a filled-in .env with real secrets.
# Every variable can also be passed as a plain environment variable.
# ---------------------------------------------------------------------------

# --- core ------------------------------------------------------------------
# SQLite (default, zero setup) or PostgreSQL:
#   postgresql+psycopg://rqm:rqm@localhost:5432/rqm
RQM_DATABASE_URL=sqlite:///./rag_monitor.db
RQM_ENVIRONMENT=development
RQM_LOG_LEVEL=INFO

# --- http security ---------------------------------------------------------
# When set, every endpoint except /health and /ready requires the header
# "X-API-Key: <value>". Leave empty for a loopback-bound development server.
RQM_API_KEY=
RQM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RQM_TRUSTED_HOSTS=
RQM_MAX_UPLOAD_BYTES=10485760
RQM_RATE_LIMIT_PER_MINUTE=600

# --- execution -------------------------------------------------------------
RQM_MAX_WORKERS=4
RQM_JOB_RETRIES=2
RQM_RUN_TIMEOUT_S=3600
RQM_SCHEDULER_ENABLED=false
RQM_SCHEDULER_TICK_S=60

# --- cost control ----------------------------------------------------------
# Default budget for an LLM-judge run, and the hard ceiling for a single run.
RQM_DEFAULT_BUDGET_USD=1.00
RQM_HARD_COST_LIMIT_USD=25.00
RQM_MAX_RUN_COST_USD=5.00

# --- alerting --------------------------------------------------------------
# Optional webhook that receives drift / gate alerts as JSON.
RQM_ALERT_WEBHOOK_URL=
RQM_ALERT_WEBHOOK_TIMEOUT_S=5

# --- AI providers ----------------------------------------------------------
# The platform stores provider credentials in the database (never in this file
# and never in git). These variables are only a convenience for the CLI.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# OLLAMA_HOST=http://localhost:11434

# --- demo ------------------------------------------------------------------
# Demo projects are flagged in the dashboard; this switch is only a hint.
RQM_DEMO_MODE=false
